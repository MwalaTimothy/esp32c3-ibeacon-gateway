# ESP32-C3 iBeacon Gateway - release repository .gitignore
#
# This repository distributes pre-built firmware binaries and documentation
# only. Source code, build tooling, and local dev artifacts are intentionally
# excluded.

# Build artifacts / intermediate binaries
*.elf
*.map
*.hex
*.dfu
.pio/
build/
dist/

# Only tracked, explicitly-named release binaries are allowed through
*.bin
!esp32c3-ibeacon-gateway-v*.bin
!carenuity-restaurant-ibeacon-v*.bin

# Firmware source / build config - not distributed from this repository
src/
lib/
test/
include/
platformio.ini

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs and debugging
*.log
core.*
debug.txt

# Temporary files
*.tmp
*.temp
*.bak
*.orig

# Documentation build artifacts
docs/_build/

# Local environment variables
.env
.env.local
